{
    "name": "review-vir",
    "version": "3.1.0",
    "private": true,
    "homepage": "https://github.com/review-vir/review-vir",
    "bugs": {
        "url": "https://github.com/review-vir/review-vir/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/review-vir/review-vir.git"
    },
    "license": "(MIT OR CC0-1.0)",
    "author": {
        "name": "review-vir",
        "url": "https://github.com/review-vir"
    },
    "type": "module",
    "workspaces": [
        "packages/*"
    ],
    "scripts": {
        "build": "npm run build --workspace @review-vir/review-vir",
        "compile": "virmator compile",
        "format": "virmator format",
        "lint": "virmator lint fix",
        "publish": "virmator publish npm run test:all",
        "start": "npm start --workspace @review-vir/review-vir",
        "test": "mono-vir for-each npm run test",
        "test:all": "npm run compile && runstorm --names tests,spelling,format,docs,deps,lint,build \"npm run test\" \"npm run test:spelling\" \"npm run test:format\" \"npm run test:deps\" \"npm run test:lint\" \"npm run build\"",
        "test:coverage": "mono-vir for-each-async npm run test:coverage",
        "test:deps": "virmator deps check",
        "test:format": "virmator format check",
        "test:lint": "virmator lint",
        "test:spelling": "virmator spellcheck",
        "test:update": "mono-vir for-each-async npm run test:update"
    },
    "overrides": {
        "esbuild": "^0.28.1"
    },
    "dependencies": {
        "@augment-vir/common": "^32.2.1",
        "date-vir": "^8.6.2",
        "local-db-client": "^2.0.0",
        "spa-router-vir": "^6.6.0",
        "type-fest": "^5.8.0",
        "typed-event-target": "^4.3.2",
        "vira": "^31.28.1"
    },
    "devDependencies": {
        "@eslint/eslintrc": "^3.3.6",
        "@eslint/js": "10.0.1",
        "@stylistic/eslint-plugin": "^5.10.0",
        "@stylistic/eslint-plugin-ts": "^4.4.1",
        "@typescript-eslint/eslint-plugin": "^8.65.0",
        "cspell": "^10.0.1",
        "dependency-cruiser": "^18.1.0",
        "esbuild": "^0.28.1",
        "eslint": "^10.7.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-jsdoc": "^63.2.0",
        "eslint-plugin-monorepo-cop": "^1.0.2",
        "eslint-plugin-playwright": "^2.10.5",
        "eslint-plugin-prettier": "^5.5.6",
        "eslint-plugin-require-extensions": "^0.1.3",
        "eslint-plugin-sonarjs": "^4.2.0",
        "eslint-plugin-unicorn": "^72.0.0",
        "markdown-code-example-inserter": "^3.0.6",
        "mono-vir": "^2.5.0",
        "npm-check-updates": "^22.2.9",
        "prettier": "~3.3.3",
        "prettier-plugin-interpolated-html-tags": "^2.0.1",
        "prettier-plugin-jsdoc": "^1.8.1",
        "prettier-plugin-multiline-arrays": "~4.1.10",
        "prettier-plugin-organize-imports": "^4.3.0",
        "prettier-plugin-packagejson": "^3.0.2",
        "prettier-plugin-sort-json": "^4.2.0",
        "prettier-plugin-toml": "^2.0.6",
        "runstorm": "^1.0.5",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.65.0",
        "virmator": "^14.30.0"
    },
    "engines": {
        "node": ">=22"
    }
}
